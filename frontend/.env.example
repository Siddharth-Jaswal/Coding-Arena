# ===================================================
# CODEARENA FRONTEND ENVIRONMENT CONFIGURATION
# ===================================================

# Set to 'local' for local development or 'prod' for deployed Render backend
VITE_APP_MODE=local

# ----------------- ACCESS PROTECTION -----------------
# Set a password to restrict site access on Vercel (leave blank in dev to bypass)
VITE_SITE_ACCESS_PASSWORD=

# ----------------- LOCAL CONFIG -----------------
VITE_LOCAL_API_URL=http://localhost:5000
VITE_LOCAL_WS_URL=http://localhost:5000
VITE_LOCAL_WORKER_URL=

# ----------------- PROD CLOUD CONFIG (RENDER) -----------------
# Replace with your actual deployed Render Web Service URLs once live
VITE_PROD_API_URL=https://your-backend-api.onrender.com
VITE_PROD_WS_URL=https://your-backend-api.onrender.com
VITE_PROD_WORKER_URL=https://your-judge-worker.onrender.com
