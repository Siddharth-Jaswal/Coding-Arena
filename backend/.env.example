# ===================================================
# CODEARENA BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ===================================================

# Set to 'local' for local development, or 'prod' for production / cloud
APP_MODE=local

NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Local Redis
LOCAL_REDIS_URL=redis://localhost:6379
LOCAL_ALLOWED_ORIGINS=http://localhost:5173

# Cloud Redis (Redis Cloud / Render Redis)
PROD_REDIS_URL=redis://default:password@host:port
PROD_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Authentication secret
JWT_SECRET=your_jwt_secret_key_here