generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  username        String   @unique
  email           String   @unique
  passwordHash    String
  displayName     String?
  avatar          String?
  rating          Int      @default(1500)
  maxRating       Int      @default(1500)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  problemsSolved  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissions     submissions[]
  problemStatuses UserProblemStatus[]

  @@map("users")
}

model UserProblemStatus {
    userId           String
    problemId        BigInt
    status           String
    bestRuntime      Int?
    bestMemory       Int?
    firstSolvedAt    DateTime?
    lastSubmissionAt DateTime

    user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    problem          problems @relation(fields: [problemId], references: [id], onDelete: Cascade)

    @@id([userId, problemId])
    @@map("user_problem_statuses")
}

model problem_assets {
  problem_id         BigInt    @id
  provider           String
  file_id            String?
  checksum           String
  version            Int       @default(1)
  archive_size_bytes BigInt?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
  problems           problems  @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model problems {
  id              BigInt          @id @default(autoincrement())
  title           String          @db.VarChar(255)
  statement       String
  difficulty      String          @db.VarChar(20)
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  slug            String?         @unique
  input_format    String?
  output_format   String?
  constraints     String[]
  tags            String[]
  time_limit_ms   Int?
  memory_limit_mb Int?
  version         Int?            @default(1)
  checksum        String?
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  problem_assets  problem_assets?
  submissions     submissions[]
  test_cases      test_cases[]
  problemStatuses UserProblemStatus[]
}

model schema_migrations {
  version    String    @id @db.VarChar(255)
  applied_at DateTime? @default(now()) @db.Timestamptz(6)
}

model submissions {
  id                BigInt    @id @default(autoincrement())
  user_id           String?
  problem_id        BigInt?
  language          String?
  source_code       String?
  status            String?   @default("queued")
  verdict           String?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  started_at        DateTime? @db.Timestamptz(6)
  finished_at       DateTime? @db.Timestamptz(6)
  execution_time_ms Int?
  
  problems          problems? @relation(fields: [problem_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user              User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model test_cases {
  id          BigInt    @id @default(autoincrement())
  problem_id  BigInt?
  case_order  Int
  input_data  String
  output_data String
  visibility  String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  problems    problems? @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([problem_id, visibility, case_order], map: "uq_problem_case")
  @@index([problem_id], map: "idx_test_cases_problem")
  @@index([problem_id, visibility], map: "idx_test_cases_visibility")
}
